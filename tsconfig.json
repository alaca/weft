{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "types": ["vite/client", "node"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
