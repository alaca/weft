# Where the app that people download finds the site and the relay of a jam, and who tells a
# machine its address from outside, so that voices and pictures find their way between two
# networks. All three are the project's own server.
VITE_SITE=https://weftloom.dev
VITE_JAM_RELAY=wss://jam.weftloom.dev
VITE_JAM_ICE=[{"urls":"stun:weftloom.dev:3478"}]
