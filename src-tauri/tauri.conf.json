{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Weft Loom",
    "version": "0.1.7",
    "identifier": "app.weft.desktop",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5180",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Weft Loom",
                "width": 1440,
                "height": 900,
                "minWidth": 1100,
                "minHeight": 700,
                "resizable": true,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-eval' blob: data:",
                "worker-src": "'self' blob: data:",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob:",
                "font-src": "'self' data:",
                "media-src": "'self' blob: data: mediastream: https://weftloom.dev",
                "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://weftloom.dev https://jam.weftloom.dev wss://jam.weftloom.dev https://raw.githubusercontent.com https://felixroos.github.io",
                "object-src": "'none'",
                "frame-src": "'none'",
                "base-uri": "'none'",
                "form-action": "'none'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-eval' 'unsafe-inline' blob: data:",
                "worker-src": "'self' blob: data:",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob:",
                "font-src": "'self' data:",
                "media-src": "'self' blob: data: mediastream: https://weftloom.dev http://127.0.0.1:5191",
                "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://weftloom.dev https://jam.weftloom.dev wss://jam.weftloom.dev https://raw.githubusercontent.com https://felixroos.github.io http://localhost:5180 ws://localhost:5180 http://127.0.0.1:5191 ws://127.0.0.1:5190 http://127.0.0.1:5190",
                "object-src": "'none'",
                "frame-src": "'none'",
                "base-uri": "'none'",
                "form-action": "'none'"
            },
            "dangerousDisableAssetCspModification": [
                "style-src"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true,
        "macOS": {
            "signingIdentity": "-",
            "entitlements": "Entitlements.plist"
        }
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": [
                    "weft"
                ]
            }
        },
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MDREMDA5NjMwQkE2M0YKUldRL3BndGpDZEFFbUE3dHd1Z25vQjRDM1F1RXc5NnNERnI2S3dGcnVHdCsrU2JTZ0g2UHVHVEkK",
            "endpoints": [
                "https://weftloom.dev/updates/latest.json"
            ]
        }
    }
}
