{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "default permissions for the main window. It may open pages of the site in the browser, and nothing else: the second address is the site as it runs on a developer's machine.",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "dialog:allow-save",
        "dialog:allow-open",
        "fs:allow-write-file",
        "fs:allow-read-file",
        "deep-link:default",
        "updater:default",
        "process:allow-restart",
        {
            "identifier": "opener:allow-open-url",
            "allow": [
                {
                    "url": "https://weftloom.dev/*"
                },
                {
                    "url": "http://127.0.0.1:5191/*"
                }
            ]
        }
    ]
}
